{
  "name": "roundcube-skin-akio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Build tooling for the Akio Roundcube skin",
  "license": "CC-BY-SA-3.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "fonts:fetch": "node scripts/acquire-fonts.mjs",
    "dev": "node scripts/build.mjs --development --watch",
    "preview": "node scripts/preview.mjs",
    "build:dev": "node scripts/build.mjs --development",
    "build": "node scripts/build.mjs --production",
    "lint:js": "eslint .",
    "lint:css": "stylelint 'src/styles/**/*.css'",
    "lint:docs": "markdownlint '**/*.md' --ignore node_modules --ignore build --ignore dist",
    "lint:format": "prettier --check package.json composer.json meta.json tailwind.config.js postcss.config.js eslint.config.js stylelint.config.mjs scripts src demo preview templates",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:docs && npm run lint:format && node scripts/validate-source.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-dist.mjs dist/akio"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "autoprefixer": "10.6.1",
    "cssnano": "7.1.2",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "lucide-static": "1.47.0",
    "markdownlint-cli": "0.47.0",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "3.4.19"
  },
  "overrides": {
    "js-yaml": "5.4.1",
    "markdown-it": "15.0.1",
    "minimatch": "10.2.4",
    "run-con": "1.3.2",
    "smol-toml": "1.8.0"
  }
}
